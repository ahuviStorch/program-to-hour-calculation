{
  "name": "time-tracker",
  "version": "1.0.0",
  "description": "אפליקציית מעקב שעות עבודה — React + Express + Tailwind",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run build && node --env-file=.env server/index.js",
    "serve": "node --env-file=.env server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
