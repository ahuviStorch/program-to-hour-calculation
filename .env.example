# ===== הגדרות שרת (העתיקו את הקובץ הזה לשם .env) =====

# הפורט שעליו מאזין שרת ה-API
PORT=3001

# מיקום קובץ הנתונים (יחסי לתיקיית הפרויקט או נתיב מוחלט)
DATA_FILE=data/db.json

# קוד ה-PIN שנדרש לכל פעולת מחיקה. חייב להכיל לפחות 4 תווים.
# חשוב: החליפו את הערך הזה לפני שימוש אמיתי!
DELETE_PIN=1234

# משך מרבי של סשן פתוח (בשעות). לאחריו הסשן נסגר אוטומטית.
AUTO_CLOSE_HOURS=6

# תדירות סריקת הרקע שסוגרת סשנים פתוחים (בדקות)
SWEEP_MINUTES=15

# מספר ניסיונות PIN שגויים לפני נעילה זמנית
PIN_MAX_FAILS=5

# משך הנעילה לאחר חריגה ממספר הניסיונות (במילישניות) — ברירת מחדל 10 דקות
PIN_LOCK_MS=600000
